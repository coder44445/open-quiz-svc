APP_NAME='Quiz Engine'

ENVIRONMENT=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

CORS_ORIGINS='["*"]'

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi
REDIS_URL=redis://localhost:6379/0

LLM_TEMPERATURE=0.3
OPENAI_API_KEY=

MAX_PLAYERS=20
MAX_TOPICS_PER_PLAYER=10
SELECTED_TOPICS_PER_GAME=5
QUESTION_TIME_LIMIT=60

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# --- Persona Service Integration ---
# Set PERSONA_BASE_URL to enable display name + avatar enrichment.
# Set PERSONA_SERVICE_TOKEN matching Persona's SERVICE_API_KEY.
PERSONA_BASE_URL=http://localhost:8001
PERSONA_SERVICE_TOKEN=dev-service-key
PERSONA_TIMEOUT=1.0

# --- JWT Authentication ---
# Must match JWT_SECRET in Identity Service.
JWT_SECRET=dev-jwt-secret-key-minimum-32-chars-long
JWT_ALGORITHM=HS256
JWT_AUDIENCE=quiz-service